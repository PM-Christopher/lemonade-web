{
  "name": "lemonade-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter lemonade-admin dev",
    "dev:frontend": "pnpm --filter lemonade-app dev",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=lemonade-app",
    "build:admin": "turbo run build --filter=lemonade-admin",
    "start:frontend": "pnpm --filter lemonade-app start",
    "start:admin": "pnpm --filter lemonade-admin start",
    "heroku-postbuild": "turbo run build --filter=${APP_NAME:-lemonade-app}",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --config packages/config/prettier.config.mjs --write \"**/*.{ts,tsx,js,jsx,json}\" --ignore-path .gitignore",
    "format:check": "prettier --config packages/config/prettier.config.mjs --check \"**/*.{ts,tsx,js,jsx,json}\" --ignore-path .gitignore",
    "lemonade:check": "pnpm run format && pnpm turbo run lint typecheck test build --filter='!@lemonade/e2e'",
    "lemonade:refresh": "mv node_modules /tmp/lemonade-node_modules-broken && pnpm install",
    "knip": "knip --dependencies"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3"
  }
}
