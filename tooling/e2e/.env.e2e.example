# Copy to .env.e2e.local (gitignored) and fill in real values, or export
# these as real environment variables in CI. See README.md.

E2E_USER_EMAIL=
E2E_USER_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# A second admin with the customer-support role (zero write permissions) —
# see permission-gating.spec.ts.
E2E_RESTRICTED_ADMIN_EMAIL=
E2E_RESTRICTED_ADMIN_PASSWORD=

# A real event id (lemonade-backend) with an active, paid ticket type —
# see ticket-purchase.spec.ts.
E2E_PAID_EVENT_ID=

# Mailpit's REST API — see signup.spec.ts. Defaults to the standard local
# port if unset, so this only needs setting when Mailpit runs somewhere else.
E2E_MAILPIT_URL=http://localhost:8025
