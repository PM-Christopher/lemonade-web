# Copy to .env.e2e.local (gitignored) and fill in real values, or export
# these as real environment variables in CI. See README.md. The values below
# are lemonade-backend's own deterministic seed defaults (config/seeding.php,
# DemoUserSeeder/AdminSeeder/E2eFixturesSeeder) — override them here only if
# that repo's SEED_*_EMAIL/PASSWORD env vars were changed from their defaults.

E2E_USER_EMAIL=user@lemonade.com
E2E_USER_PASSWORD=Admin12345#

E2E_ADMIN_EMAIL=admin@lemonade.com
E2E_ADMIN_PASSWORD=Admin12345#

# A second admin with the customer-support role (zero write permissions) —
# see permission-gating.spec.ts. Deterministically seeded by lemonade-
# backend's E2eFixturesSeeder (config/seeding.php's restricted_admin_*
# keys) — these values are that seeder's own defaults, matching
# SEED_RESTRICTED_ADMIN_EMAIL/PASSWORD in that repo's .env.example.
E2E_RESTRICTED_ADMIN_EMAIL=e2e-restricted-admin@lemonade.com
E2E_RESTRICTED_ADMIN_PASSWORD=Admin12345#

# A real event id (lemonade-backend) with an active, paid ticket type — see
# ticket-purchase.spec.ts. Deterministically seeded by lemonade-backend's
# E2eFixturesSeeder — this fixed value is that seeder's own constant
# (E2eFixturesSeeder::PAID_EVENT_ID), not something to look up per
# environment.
E2E_PAID_EVENT_ID=00000000-0000-7000-8000-e2e000000001

# Mailpit's REST API — see signup.spec.ts. Defaults to the standard local
# port if unset, so this only needs setting when Mailpit runs somewhere else.
E2E_MAILPIT_URL=http://localhost:8025
