{
  "name": "@lemonade/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens (one Tailwind preset) and primitives only: Button, Input, Field, Select, Dialog, Table, Pagination, Toast, Skeleton, EmptyState, FormField. Primitives, not features — no component here may import @lemonade/api-client. See docs/ARCHITECTURE.md §7.",
