{
  "name": "@lemonade/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "Generated contract types: response envelope, ErrorCode, TokenType, paginated-list types, one type per API Resource. Generated only — hand-edits are rejected in review. See docs/ARCHITECTURE.md §7.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts"
  },
  "scripts": {
    "generate": "node ../../tooling/generate-api-types/generate.mjs --manifest ../../tooling/generate-api-types/manifest.snapshot.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@lemonade/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
