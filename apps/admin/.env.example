# Server-only — never prefix with NEXT_PUBLIC_. This is the only place the
# Laravel origin is configured; the browser never talks to it directly (see
# src/lib/server-api.ts and src/app/api/v1/[...path]/route.ts).
LARAVEL_API_URL=http://127.0.0.1:9900

# Legacy — still read directly by src/config/url.ts and every unmigrated
# feature slice's axiosInstance until each domain moves to the new BFF
# client in Phase 5. Points at the same backend as LARAVEL_API_URL above.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:9900

NEXT_PUBLIC_PUSHER_KEY=
