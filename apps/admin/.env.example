# See src/lib/env.server.ts and src/lib/env.client.ts — both validate these
# at startup and throw with a clear message if a required one is missing.

# --- Required ---

# lemonade-backend's own base URL. Server-only — read by the BFF proxy
# (src/lib/server-api.ts) and a couple of Route Handlers that call the
# backend directly. Never exposed to the browser.
LARAVEL_API_URL=http://127.0.0.1:9900

# The BFF's own base URL, as seen by the browser (src/config/url.ts).
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:9900

# --- Optional ---

# Pusher (moderation/withdrawal realtime updates) — unused today, see
# src/config/pusherConfig.ts.
NEXT_PUBLIC_PUSHER_KEY=
