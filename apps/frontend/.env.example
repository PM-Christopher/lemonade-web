# See src/lib/env.server.ts and src/lib/env.client.ts — both validate these
# at startup and throw with a clear message if a required one is missing.

# --- Required ---

# lemonade-backend's own base URL. Server-only — read by the BFF proxy
# (src/lib/server-api.ts). Never exposed to the browser.
LARAVEL_API_URL=http://127.0.0.1:9900

# This app's own public origin. Used to build absolute links sent to the
# backend (payment/OAuth redirect URLs, tribe share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The BFF's own base URL, as seen by the browser (src/config/url.ts).
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:9900

# --- Optional ---

# OTP resend countdown (verify-code/verify-email). Defaults to 60 seconds /
# "otp_timer_start" if unset.
NEXT_PUBLIC_COUNTDOWN_DURATION=60
NEXT_PUBLIC_COUNTDOWN_STORAGE_KEY=otp_timer_start

# Google OAuth login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Pusher (chat/notifications realtime).
NEXT_PUBLIC_PUSHER_KEY=

# Firebase (push notifications) — the feature degrades rather than crashing
# when these are unset.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
